 "extra": {
  "type": "grammar",
  "title": "+Этот, +эта, +эти",
  "titleEn": "This and that",
  "ru": "+Это дом. ≠ +Этот дом н+овый.",
  "table": [
   [
    "дом (he)",
    "+этот дом",
    "тот дом"
   ],
   [
    "маш+ина (she)",
    "+эта маш+ина",
    "та маш+ина"
   ],
   [
    "сл+ово (it)",
    "+это сл+ово",
    "то сл+ово"
   ],
   [
    "д+ети (plural)",
    "+эти д+ети",
    "те д+ети"
   ]
  ],
  "note": "+Этот / +эта / +эти = this / these. It matches the noun, like мой / мо+я / мо+и. Тот / та / то / те = that. Careful: +Это on its own means “this is” and never changes: +Это маш+ина = This is a car. +Эта маш+ина н+овая = This car is new.",
  "input": [
   {
    "ru": "+Эта маш+ина н+овая.",
    "q": "What does it say?",
    "opts": [
     "This car is new.",
     "This is a new car."
    ],
    "a": 0,
    "why": "+эта + noun = this car"
   },
   {
    "ru": "+Это н+овая маш+ина.",
    "q": "What does it say?",
    "opts": [
     "This is a new car.",
     "This car is new."
    ],
    "a": 0,
    "why": "+это on its own = this is"
   },
   {
    "ru": "+Эти л+юди бог+атые.",
    "q": "Who is rich?",
    "opts": [
     "these people",
     "this man",
     "that woman"
    ],
    "a": 0,
    "why": "+эти = these"
   },
   {
    "ru": "Тот мужч+ина — мой сос+ед.",
    "q": "Who is the neighbour?",
    "opts": [
     "that man",
     "this woman",
     "those people"
    ],
    "a": 0,
    "why": "тот = that (a “he” word)"
   }
  ],
